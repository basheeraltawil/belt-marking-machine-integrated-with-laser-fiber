<?xml version="1.0"?>
<!-- Gazebo Fortress extras: joint position controllers for the animated joints and the
     vision QA camera. Topics are bridged by belt_marking_gazebo/config/bridge.yaml. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gz_joint_position" params="joint topic p:=200 d:=5 cmd_max:=100">
    <gazebo>
      <plugin filename="ignition-gazebo-joint-position-controller-system"
              name="ignition::gazebo::systems::JointPositionController">
        <joint_name>${joint}</joint_name>
        <topic>${topic}</topic>
        <p_gain>${p}</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>${d}</d_gain>
        <cmd_max>${cmd_max}</cmd_max>
        <cmd_min>${-cmd_max}</cmd_min>
      </plugin>
    </gazebo>
    <gazebo reference="${joint}">
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="gz_station" params="idx n">
    <xacro:if value="${idx &lt; n}">
      <xacro:gz_joint_position joint="laser_${idx}_head_x" topic="/belt_sim/laser_${idx}_head_x"/>
      <xacro:gz_joint_position joint="laser_${idx}_head_y" topic="/belt_sim/laser_${idx}_head_y"/>
      <xacro:gz_joint_position joint="laser_${idx}_beam" topic="/belt_sim/laser_${idx}_beam"/>
      <gazebo reference="laser_${idx}_carriage"><gravity>false</gravity></gazebo>
      <gazebo reference="laser_${idx}_head"><gravity>false</gravity></gazebo>
      <gazebo reference="laser_${idx}_beam_link"><gravity>false</gravity></gazebo>
      <xacro:gz_station idx="${idx + 1}" n="${n}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="gazebo_extras" params="n_stations">
    <xacro:gz_joint_position joint="knife_joint" topic="/belt_sim/knife_joint" p="400"/>
    <gazebo reference="knife_blade"><gravity>false</gravity></gazebo>
    <xacro:gz_station idx="0" n="${n_stations}"/>

    <gazebo reference="qa_camera_link">
      <sensor type="camera" name="qa_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/qa_camera/image_raw</topic>
        <camera>
          <horizontal_fov>0.8</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>2.0</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
